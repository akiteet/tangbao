{
  "name": "tangbao-web",
  "version": "1.2.0",
  "private": true,
  "description": "糖包 Tangbao — 本地优先、私密可控的 AI 工作空间",
  "author": "Tangbao Project",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/infrastructure/agent-runtime/agent-server.js",
    "dist": "electron-builder",
    "test": "node scripts/run-tests.js",
    "test:runtime": "node scripts/run-tests.js",
    "bench": "node scripts/bench.js",
    "bench:offline": "node scripts/bench.js --suite multi-agent --mode offline",
    "eval": "node scripts/bench.js --eval",
    "eval:one": "node scripts/bench.js --eval",
    "bump": "node scripts/bump-version.js",
    "check:version": "node scripts/check-version.js",
    "check:storage": "node scripts/check-storage.js",
    "check:perf": "node scripts/check-perf.js",
    "check:electron-abi": "electron scripts/check-electron-abi.js",
    "check:sqlite": "node scripts/run-sqlite-tests.js",
    "rebuild:electron": "node scripts/rebuild-better-sqlite3-electron.js",
    "check:ui": "node scripts/check-ui-consistency.js && electron scripts/ui-smoke-app",
    "check:release": "node scripts/check-release.js",
    "check:ui-consistency": "node scripts/check-ui-consistency.js"
  },
  "build": {
    "appId": "com.tangbao.desktop",
    "productName": "糖包",
    "publish": {
      "provider": "github",
      "owner": "akiteet",
      "repo": "tangbao"
    },
    "icon": "assets/app-icon.ico",
    "files": [
      "src/**/*",
      "index.html",
      "splash.html",
      "styles.css",
      "assets/**/*",
      "vendor/**/*",
      "docs/**/*",
      "README.md",
      "README.en.md",
      "benchmarks/tasks.json",
      "benchmarks/fixtures/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/build/**"
    ],
    "extraResources": [
      {
        "from": "src/infrastructure/secrets/kvstore.js",
        "to": "kvstore.js"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "artifactName": "tangbao-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.png",
      "artifactName": "tangbao-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "better-sqlite3@12.11.1": true
  }
}
