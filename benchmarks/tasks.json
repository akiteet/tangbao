{
  "version": 1,
  "description": "糖码 v1.1.0 M0 评测基线任务集。fixtureDir 为空的通用任务直接在任意项目上运行（goal 里注明目标文件）；带 fixtureDir 的任务需先准备样例仓库。",
  "tasks": [
    {
      "id": "simple-001",
      "title": "修改一个文案",
      "goal": "把当前项目 README 或项目说明文件开头的一段介绍改写得更简洁清晰，保持原有格式。",
      "expectedChecks": [
        {
          "type": "file_contains",
          "path": "README.md",
          "text": "# Demo 项目"
        },
        {
          "type": "event",
          "eventType": "tool_diff"
        }
      ],
      "timeoutSteps": 5,
      "tags": [
        "simple",
        "text"
      ],
      "compare": true,
      "fixtureDir": "fixtures/simple-text"
    },
    {
      "id": "simple-002",
      "title": "修复单文件空值错误",
      "goal": "找到项目里一个对可能为 null 的变量直接取值导致报错的函数并修复，补上空值保护。",
      "expectedChecks": [
        {
          "type": "file_contains",
          "path": "src/main.js",
          "regex": "count\\s*==\\s*null|typeof\\s+\\w+\\s*===?\\s*['\"]undefined['\"]|\\?\\?\\s*0|\\|\\|\\s*0"
        },
        {
          "type": "command",
          "command": "node --check src/main.js"
        }
      ],
      "timeoutSteps": 8,
      "tags": [
        "simple",
        "bugfix"
      ],
      "compare": true,
      "fixtureDir": "fixtures/multi-lang-js"
    },
    {
      "id": "simple-003",
      "title": "增加一个简单配置项",
      "goal": "在项目配置里增加一个布尔开关（如 feature_flag），并在入口处读取它打印到控制台。",
      "expectedChecks": [
        {
          "type": "file_contains",
          "path": "src/config.js",
          "regex": "feature_flag|featureFlag|feature\\s*[:=]"
        },
        {
          "type": "file_contains",
          "path": "src/main.js",
          "regex": "config\\.[a-zA-Z]*[Ff]eature|feature_flag|featureFlag"
        },
        {
          "type": "command",
          "command": "node src/main.js"
        }
      ],
      "timeoutSteps": 6,
      "tags": [
        "simple",
        "config"
      ],
      "compare": true,
      "fixtureDir": "fixtures/simple-config"
    },
    {
      "id": "simple-004",
