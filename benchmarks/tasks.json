        {
          "type": "file_contains",
          "path": "test/utils.test.js",
          "regex": "test\\s*\\("
        },
        {
          "type": "test_files",
          "path": "test",
          "suffix": ".test.js"
        }
      ],
      "timeoutSteps": 8,
      "tags": [
        "simple",
        "test",
        "test-only"
      ],
      "compare": true,
      "fixtureDir": "fixtures/simple-test"
    },
